# Expo prebuild output — regenerated by `expo prebuild`, not source.
# Listed individually (instead of `ios/`) so we can keep ios/fastlane/ and
# ios/Gemfile under version control. Negation patterns like `!ios/fastlane/`
# do NOT work once the parent dir is ignored.
ios/AgroField/
ios/AgroField.xcodeproj/
ios/AgroField.xcworkspace/
ios/Pods/
ios/Podfile
ios/Podfile.lock
ios/Podfile.properties.json
ios/build/
ios/.xcode.env*

# fastlane build artifacts (do NOT commit signing certs / private keys)
ios/*.cer
ios/*.certSigningRequest
ios/*.p12
ios/*.mobileprovision
ios/*.ipa
ios/*.app.dSYM.zip
ios/fastlane/report.xml
ios/fastlane/Preview.html
ios/fastlane/screenshots
ios/fastlane/test_output
ios/fastlane/.env*

android/

.expo/
*.log
