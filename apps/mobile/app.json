{
  "expo": {
    "name": "AgroField",
    "slug": "agrofield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d6c1c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.agrofield.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "O AgroField usa sua localização para registrar as coordenadas GPS das visitas e do diário de campo.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O AgroField usa sua localização para registrar as coordenadas GPS das visitas e do diário de campo.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1d6c1c"
      },
      "package": "dev.agrofield.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "apiUrl": "https://agrofieldapi-production.up.railway.app",
      "eas": {
        "projectId": "c558a963-a657-4743-8738-debeaf4128ab"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O AgroField usa sua localização para registrar as coordenadas GPS das visitas e do diário de campo."
        }
      ]
    ],
    "owner": "diegoguerra"
  }
}
